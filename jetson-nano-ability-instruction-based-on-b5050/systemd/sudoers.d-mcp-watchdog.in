# /etc/sudoers.d/mcp-watchdog
#
# OPTIONAL — only deploy this if you want to invoke
# mcp-csi-camera-watchdog.sh manually as @@SERVICE_USER@@ (e.g. for
# testing or one-off recovery from an SSH session). The default install
# runs the watchdog as a root systemd service, in which case the script
# already has all the privilege it needs and this file is unnecessary.
#
# Permissions on this file MUST be 0440 — visudo / install.sh enforce
# that. A bad mode here disables every other sudoers rule on the system.
#
# Generated by jetson-nano-ability-instruction-based-on-b5050/systemd/install.sh
# from sudoers.d-mcp-watchdog.in.

# Allow @@SERVICE_USER@@ to perform exactly the privileged calls the
# escalation ladder needs — nothing more. No wildcards, no extra
# binaries.
@@SERVICE_USER@@ ALL=(root) NOPASSWD: /bin/systemctl restart mcp-csi-camera.service
@@SERVICE_USER@@ ALL=(root) NOPASSWD: /bin/systemctl restart mcp-csi-camera
@@SERVICE_USER@@ ALL=(root) NOPASSWD: /bin/systemctl restart nvargus-daemon.service
@@SERVICE_USER@@ ALL=(root) NOPASSWD: /bin/systemctl restart nvargus-daemon
@@SERVICE_USER@@ ALL=(root) NOPASSWD: /bin/systemctl reboot
@@SERVICE_USER@@ ALL=(root) NOPASSWD: /sbin/reboot
